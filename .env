# PostgreSQL Database Configuration
DB_PASSWORD=plpredict2025 # <-- ENTER YOUR SUPER SECRET DATABASE PASSWORD HERE
DB_USER= PLpredict # <-- Optional: Enter a custom database user, default is 'postgres'
DB_NAME=premier_league # <-- Optional: Enter a custom database name, default is 'mydatabase'

# Host Port Mapping
# The port on YOUR local machine that will map to the PostgreSQL port (5432) inside the container.
# Change this if port 5432 is already in use on your machine.
HOST_POSTGRES_PORT=5432