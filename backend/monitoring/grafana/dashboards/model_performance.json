{
  "title": "EPL Prediction Operations",
  "uid": "epl-predictions",
  "tags": ["epl", "predictions"],
  "schemaVersion": 36,
  "version": 2,
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Prediction requests in 24 hours",
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(increase(http_requests_total{job=\"epl-api\",handler=\"/api/v1/predictions\",method=\"POST\"}[24h]))", "legendFormat": "requests" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Failed prediction requests in 24 hours",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "sum(increase(http_requests_total{job=\"epl-api\",handler=\"/api/v1/predictions\",method=\"POST\",status=~\"4xx|5xx\"}[24h]))", "legendFormat": "failed requests" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Prediction request rate",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 5 },
      "targets": [
        { "expr": "sum(rate(http_requests_total{job=\"epl-api\",handler=\"/api/v1/predictions\",method=\"POST\",status=\"2xx\"}[5m]))", "legendFormat": "successful requests/s" },
        { "expr": "sum(rate(http_requests_total{job=\"epl-api\",handler=\"/api/v1/predictions\",method=\"POST\",status=~\"4xx|5xx\"}[5m]))", "legendFormat": "failed requests/s" }
      ]
    }
  ]
}
