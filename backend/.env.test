# ai-engine\.env.test

# ----- General Settings -----
ENVIRONMENT="test"  # Quan trọng: Sẽ vô hiệu hóa ghi file log
LOG_LEVEL="DEBUG"   # Để xem log chi tiết nhất khi test

# PostgreSQL Database Configuration
HOST=localhost
PORT=5432
DBNAME=premier_league
USER=PLpredict
PASSWORD=plpredict2025

# === Sofascore ===
# SofaScore Settings
SOFASCORE_BASE_URL=https://api.sofascore.com/api/v1
SOFASCORE_WEB_URL=https://www.sofascore.com
SOFASCORE_EPL_ID=17
SOFASCORE_RATE_LIMIT=30
SOFASCORE_DELAY=2.0
SOFASCORE_MAX_RETRIES=5
SOFASCORE_RETRY_DELAY=3.0
SOFASCORE_EXPONENTIAL_BACKOFF=true
SOFASCORE_CIRCUIT_THRESHOLD=5
SOFASCORE_CIRCUIT_TIMEOUT=300
SOFASCORE_SESSION_ROTATION=100
SOFASCORE_ENABLE_COOKIES=true

# === Scraping ===
SCRAPING_TIMEOUT=45
SCRAPING_CONNECT_TIMEOUT=15
SCRAPING_READ_TIMEOUT=30
SCRAPING_MAX_RETRIES=5
SCRAPING_RETRY_DELAY=2.0
SCRAPING_BACKOFF_FACTOR=2.5
SCRAPING_DELAY=2.0
SCRAPING_RANDOM_DELAY=(1.5, 4.0) 
SCRAPING_CONCURRENT=3
SCRAPING_ENABLE_JS=false
SCRAPING_HEADLESS=true
SCRAPING_BROWSER=chrome
SCRAPING_PROXIES=""
SCRAPING_ROTATE_PROXIES=true
SCRAPING_PROXY_ROTATION=50
SCRAPING_ENABLE_CACHE=true
SCRAPING_CACHE_TTL=7200
SCRAPING_CACHE_DIR=cache/scraping
SCRAPING_IGNORE_SSL=false
SCRAPING_IGNORE_ROBOTS=true
SCRAPING_MAX_REDIRECTS=5
SCRAPING_VALIDATE_JSON=true
SCRAPING_MIN_RESPONSE_SIZE=10
SCRAPING_MAX_RESPONSE_SIZE=10485760 
SCRAPING_ENABLE_METRICS=true
SCRAPING_LOG_FAILURES=true
SCRAPING_SAVE_FAILURES=false
SCRAPING_BROWSER_IMPERSONATE="chrome110"

# === Season Config ===
SEASON_TIMEZONE=Europe/London
SUPPORTED_SEASONS=2016:2016/17,2017:2017/18,2018:2018/19,2019:2019/20,2020:2020/21,2021:2021/22,2022:2022/23,2023:2023/24,2024:2024/25
SEASON_TO_FETCH=7