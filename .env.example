# Docker Compose. Không commit tệp .env thật.
COMPOSE_PROJECT_NAME=epl
# Giữ tên này để dùng volume EPL cũ. Môi trường độc lập phải có tên riêng.
POSTGRES_VOLUME_NAME=epl-postgres-data
DB_NAME=epl_db
DB_USER=epl_user
DB_PASSWORD=
DB_PORT_HOST=5432

LEAGUE=epl
BIND_ADDRESS=127.0.0.1
API_PORT=8000
API_WORKERS=1
ENVIRONMENT=production
LOG_LEVEL=INFO
FRONTEND_PORT=3000
# Chỉ cần khi trình duyệt gọi trực tiếp API qua origin khác.
FRONTEND_URL=

# ID giải và quy tắc mùa nằm trong backend/config/leagues.json.
PROVIDER=sofascore
SEASONS_TO_FETCH=7
SOFASCORE_PREMATCH_HOURS=48
API_FOOTBALL_KEY=
API_FOOTBALL_MAX_REQUESTS=1000
SCRAPING_CONNECT_TIMEOUT=15
SCRAPING_READ_TIMEOUT=30
SCRAPING_MAX_RETRIES=5
SCRAPING_BACKOFF_FACTOR=2.5
SCRAPING_BROWSER_IMPERSONATE=chrome110
SCRAPING_MIN_DELAY=1
SCRAPING_MAX_DELAY=3

# Đường dẫn TRONG container; đổi thành đường dẫn trên máy khi chạy Python trực tiếp.
ML_CONFIG_PATH=/app/ml/config/default.json
RELEASE_POLICY_PATH=/app/ml/config/release.json
# MODEL_PATH chỉ dành cho artifact cố định; để trống khi dùng registry/promotion.
# MODEL_PATH=

SCHEDULE_INTERVAL_SECONDS=21600
SCHEDULE_TIMEOUT_SECONDS=10800
SCHEDULE_SEASON_COUNT=1
INSTALL_TRACKING=0
MLFLOW_TRACKING_URI=

# Chỉ khởi động khi bật profile monitoring.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=
