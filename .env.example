# ══════════════════════════════════════════════════════════════════════════════
# Premier League Prediction System - Docker Compose Environment
# Copy this file to .env and fill in your values.
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=epl_db
DB_USER=epl_user
DB_PASSWORD=
DB_PORT_HOST=5432

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=8000
API_WORKERS=1
MODEL_PATH=/app/models/ensemble_model.pkl
BIND_ADDRESS=127.0.0.1
LOG_LEVEL=INFO
ENVIRONMENT=production

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_PORT=3000
API_INTERNAL_URL=http://api:8000

# ── Data Provider ─────────────────────────────────────────────────────────────
PROVIDER=sofascore
SOFASCORE_EPL_ID=17
SEASONS_TO_FETCH=7

# Đường dẫn trong container; tạo bản sao JSON trong backend/ml/config khi muốn thử tham số khác.
ML_CONFIG_PATH=/app/ml/config/default.json

# ── Monitoring ────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=

