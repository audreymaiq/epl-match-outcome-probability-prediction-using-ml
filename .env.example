# ══════════════════════════════════════════════════════════════════════════════
# Premier League Prediction System - Docker Compose Environment
# Copy this file to .env and fill in your values.
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=epl_db
DB_USER=epl_user
DB_PASSWORD=epl_password
DB_PORT_HOST=5432

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=8000
API_WORKERS=2
LOG_LEVEL=INFO
ENVIRONMENT=production

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Data Provider ─────────────────────────────────────────────────────────────
PROVIDER=sofascore
SOFASCORE_LEAGUE_ID=17
SOFASCORE_SEASON_ID=52186

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_PORT=5000

# ── Monitoring ────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

