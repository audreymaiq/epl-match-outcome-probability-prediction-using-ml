# THIS FILE CONTAINS SENSITIVE INFORMATION LIKE PASSWORDS!
# DO NOT COMMIT THIS FILE TO PUBLIC GIT REPOSITORIES!

DB_PASSWORD=YourSuperSecretPasswordHere # <-- Thay thế bằng mật khẩu thật của bạn
DB_USER=your_project_user # <-- (Tùy chọn) Thay thế bằng user bạn muốn, hoặc xóa dòng này để dùng 'postgres' mặc định
DB_NAME=your_project_database # <-- (Tùy chọn) Thay thế bằng tên DB bạn muốn, hoặc xóa dòng này để dùng 'mydatabase' mặc định
HOST_POSTGRES_PORT=5432